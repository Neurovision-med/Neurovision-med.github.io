  "glossary": {
    "cards": [
      {
        "id": "cognitively_normal_cn",
        "header": "Cognitively normal (CN)",
        "description": "people who are the \"healthy control group,\u201d meaning they have normal memory, normal thinking, and no signs of dementia."
      },
      {
        "id": "stable_cn",
        "header": "Stable CN",
        "description": "A person whose memory and thinking skills stay normal over time and don\u2019t show signs of cognitive decline."
      },
      {
        "id": "progressive_cn",
        "header": "Progressive CN",
        "description": "A person who starts with normal memory and thinking skills but later begins to experience cognitive decline and may develop dementia."
      },
      {
        "id": "cognitive_resilience",
        "header": "Cognitive Resilience",
        "description": "The brain's ability to function despite underlying pathology. Resilience decreases as pathologies accumulate."
      },
      {
        "id": "neurodegeneration",
        "header": "Neurodegeneration",
        "description": "The loss of structure and function of a neuron where they eventually die."
      },
      {
        "id": "mild_cognitive_impairment_mci",
        "header": "Mild Cognitive Impairment (MCI)",
        "description": "A state that\u2019s characterized by a decline in cognitive abilities (memory/thinking) that interferes with daily function. It increases the risk of an individual developing dementia, however there is also the chance that the individual remains cognitively stable."
      },
      {
        "id": "stable_mci",
